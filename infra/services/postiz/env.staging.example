# Mount as postiz.env in upstream compose (/config/postiz.env) — host only.
# Full variable list: https://docs.postiz.com/self-host/configuration

FRONTEND_URL=http://127.0.0.1:14007
BACKEND_URL=http://127.0.0.1:14007
POSTIZ_JWT_SECRET=replace_with_openssl_rand_hex_32
POSTIZ_DATABASE_URL=postgresql://POSTIZ_USER:POSTGRES_PASSWORD_PLACEHOLDER@postiz-postgres:5432/postiz-db-local
POSTIZ_REDIS_URL=redis://postiz-redis:6379
POSTIZ_POSTGRES_USER=postiz-user
POSTIZ_POSTGRES_PASSWORD=replace_with_strong_password
POSTIZ_POSTGRES_DB=postiz-db-local
TEMPORAL_POSTGRES_PASSWORD=replace_with_strong_password
POSTIZ_DISABLE_REGISTRATION=true

# WebXXL will supply API tokens via secret ref at SOCIAL-04 — not in git
# POSTIZ_API_KEY=
