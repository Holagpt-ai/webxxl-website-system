# Copy to host-only path (never commit). Illustrative names — align with lib/platform/integrations/isolated-services.ts

WEBXXL_ENV=staging
WEBXXL_STAGING_SERVICE=

# Optional WebXXL Vercel/staging app (not started by these compose files)
WEBXXL_APP_BASE_URL=https://staging.example.webxxl.internal

# Isolated service base URLs (localhost bindings from compose files)
CHATWOOT_BASE_URL=http://127.0.0.1:13000
POSTIZ_STAGING_BASE_URL=http://127.0.0.1:14007
PAPERCLIP_BASE_URL=http://127.0.0.1:13100

# Existing production Postiz (inventory only — do not point staging compose at this URL)
POSTIZ_PRODUCTION_CANDIDATE_URL=https://app.webbxxl.com

# Secret references (host secret manager keys — not literal secrets)
CHATWOOT_API_ACCESS_TOKEN_REF=
POSTIZ_API_TOKEN_REF=
PAPERCLIP_API_TOKEN_REF=
