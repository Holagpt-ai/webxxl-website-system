# WebXXL isolated staging database binding (host-only — never commit literals)
# Copy to a private path, e.g. .env.staging.local (gitignored).
#
# Owner-identified Supabase projects (2026-11-02):
#   Production (do NOT use for staging env): txfxeehglqfszletuumn
#   Staging (this file):                    vcgibefnhneaqhcguhnt
#
# Password: Supabase Dashboard → Project vcgibefnhneaqhcguhnt → Settings → Database
#           → Database password (reset if unknown). Do not copy production credentials.
#
# Network: if db.{ref}.supabase.co:5432 does not resolve, use Session Pooler (port 5432)
# with username postgres.{ref} — see lib/platform/pilot/staging-database-preflight.ts.
#
# Prisma: migrate deploy uses DIRECT_URL. When direct host is unreachable, set DIRECT_URL
# to the SAME Session Pooler URI as DATABASE_URL (not transaction pooler :6543).

WEBXXL_STAGING_DATABASE_IDENTITY=supabase:vcgibefnhneaqhcguhnt/postgres
WEBXXL_PRODUCTION_DATABASE_IDENTITY=supabase:txfxeehglqfszletuumn/postgres

# Legacy equivalent (still accepted): db.vcgibefnhneaqhcguhnt.supabase.co:5432/postgres

# Session Pooler — replace PLACEHOLDER_STAGING_DB_PASSWORD with staging project password only.
DATABASE_URL=postgresql://postgres.vcgibefnhneaqhcguhnt:PLACEHOLDER_STAGING_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require
DIRECT_URL=postgresql://postgres.vcgibefnhneaqhcguhnt:PLACEHOLDER_STAGING_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# Set only after you independently verify staging project ref ≠ production (txfxeehglqfszletuumn).
# Required for migration-rehearsal --verify-db and prisma migrate deploy runbooks.
WEBXXL_STAGING_BOUNDARIES_CONFIRMED=
