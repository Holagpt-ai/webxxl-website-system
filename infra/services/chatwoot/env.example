# Chatwoot staging — copy to .env on host only (gitignored). See upstream .env.example:
# https://github.com/chatwoot/chatwoot/blob/develop/.env.example

FRONTEND_URL=http://127.0.0.1:13000
SECRET_KEY_BASE=replace_with_openssl_rand_hex_64
POSTGRES_PASSWORD=replace_with_strong_password
REDIS_PASSWORD=replace_with_strong_password
REDIS_URL=redis://:replace_with_strong_password@redis:6379
POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_DATABASE=chatwoot
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
ACTIVE_STORAGE_SERVICE=local
