# Upstream docker/.env — generate secrets once per deployment (openssl rand -hex 32)

BETTER_AUTH_SECRET=replace_with_openssl_rand_hex_32
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=replace_with_openssl_rand_hex_32
PAPERCLIP_POSTGRES_USER=paperclip
PAPERCLIP_POSTGRES_PASSWORD=replace_with_strong_password
PAPERCLIP_POSTGRES_DB=paperclip
PAPERCLIP_PUBLIC_URL=http://127.0.0.1:13100
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private

# Optional for agent runs (host secret manager)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
