generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum CustomerAccountStatus {
  ACTIVE
  ONBOARDING
  PAUSED
  CLOSED
}

enum MembershipRole {
  OWNER
  MEMBER
}

enum ProjectType {
  WEBSITE
  REDESIGN
  ECOMMERCE
  LANDING
  CRM
  OTHER
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum AssignedSide {
  WEBXXL
  CUSTOMER
}

enum DependencyStatus {
  REQUESTED
  IN_PROGRESS
  RESOLVED
  CANCELLED
}

enum CommentVisibility {
  CUSTOMER
  INTERNAL
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum ChangeRequestStatus {
  SUBMITTED
  REVIEWING
  APPROVED
  SCHEDULED
  COMPLETED
  DECLINED
}

enum ChangeRequestCategory {
  DESIGN
  CONTENT
  MEDIA
  FUNCTIONALITY
  OTHER
}

enum ChangeRequestPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SupportRequestStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum CustomerServiceStatus {
  ACTIVE
  PENDING
  INACTIVE
}

enum ServiceOrderStatus {
  REQUESTED
  UNDER_REVIEW
  QUOTED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
}

enum ServiceOrderActivityType {
  CREATED
  STATUS_CHANGED
  ASSIGNED
  QUOTE_SET
  NOTE_ADDED
  ENTITLEMENT_ACTIVATED
}

enum InfrastructureDataSource {
  MANUAL
  PROVIDER_VERIFIED
}

enum InfrastructureManagementMode {
  MANUAL
  PROVIDER_READONLY
  PROVIDER_SYNC_READY
}

enum HostingServiceStatus {
  ACTIVE
  PENDING
  SUSPENDED
  CANCELLED
  UNKNOWN
}

enum HostingSslStatus {
  UNKNOWN
  NOT_APPLICABLE
  PENDING
  ACTIVE
  EXPIRED
}

enum DomainRenewalStatus {
  UNKNOWN
  AUTO
  MANUAL
  PENDING
  EXPIRED
}

enum DomainVerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum BusinessEmailServiceStatus {
  ACTIVE
  PENDING
  SUSPENDED
  CANCELLED
  UNKNOWN
}

enum InfrastructureAssetType {
  HOSTING
  DOMAIN
  EMAIL
}

enum ProjectFileCategory {
  BRAND
  PHOTO
  DOCUMENT
  OTHER
}

enum ProjectActivityEventType {
  PROJECT_CREATED
  MILESTONE_STARTED
  MILESTONE_COMPLETED
  TASK_COMPLETED
  DEPENDENCY_REQUESTED
  DEPENDENCY_RESOLVED
  FILE_UPLOADED
  FILE_DELETED
  COMMENT_POSTED
  APPROVAL_REQUESTED
  APPROVAL_APPROVED
  CHANGES_REQUESTED
  CHANGE_REQUEST_SUBMITTED
  CHANGE_REQUEST_UPDATED
  SUPPORT_REQUEST_CREATED
  WEBSITE_PREVIEW_REGISTERED
  OWNER_REVIEW_ITEM_UPDATED
}

enum OwnerReviewItemCategory {
  MEDIA
  CONTENT
  PRIVACY
}

enum OwnerReviewItemStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  NOT_APPLICABLE
}

enum WebsitePreviewProvider {
  VERCEL
  NETLIFY
  CLOUDFLARE_PAGES
  OTHER
}

enum WebsitePreviewStatus {
  DEVELOPMENT
  READY_FOR_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SUPERSEDED
}

enum ManagedSiteStatus {
  ACTIVE
  SETUP
  DISCONNECTED
  PAUSED
}

enum ManagedSitePlatform {
  NEXTJS
  WORDPRESS
  CUSTOM
  OTHER
}

enum ManagedSiteConnectionType {
  WEBXXL_NATIVE
  API
  EXTERNAL_ADMIN
  MANUAL
}

enum CapabilityExecutionMode {
  SELF_SERVICE
  AI_ASSISTED
  HUMAN_REQUIRED
  READ_ONLY
}

enum ManagedSiteChangeStatus {
  DRAFT
  AWAITING_APPROVAL
  APPROVED
  APPLIED
  FAILED
  CANCELLED
  ESCALATED
}

enum NotificationType {
  DEPENDENCY_REQUESTED
  APPROVAL_REQUESTED
  PROJECT_MESSAGE
  CHANGE_REQUEST_UPDATE
  MILESTONE_UPDATE
  GENERAL
}

enum AutomationEventType {
  PROJECT_CREATED
  MILESTONE_COMPLETED
  APPROVAL_REQUESTED
  CUSTOMER_APPROVAL_SUBMITTED
  CUSTOMER_MESSAGE_RECEIVED
  CHANGE_REQUEST_SUBMITTED
  LEAD_RECEIVED
  LEAD_ASSIGNED
  LEAD_FOLLOW_UP_DUE
  LEAD_CONVERTED
  SERVICE_ORDER_REQUESTED
  SERVICE_ORDER_QUOTE_READY
  SERVICE_ORDER_STATUS_UPDATED
  SERVICE_ACTIVATED
  DOMAIN_RENEWAL_APPROACHING
  HOSTING_RENEWAL_APPROACHING
  EMAIL_SERVICE_RENEWAL_APPROACHING
  INFRASTRUCTURE_SUPPORT_REQUEST_SUBMITTED
}

enum AutomationDeliveryChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum AutomationDeliveryStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
  DEAD
}

enum LeadSource {
  CONTACT
  PROJECT_INTAKE
  QUOTE_REQUEST
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  WON
  LOST
}

enum LeadActivityType {
  CREATED
  STAGE_CHANGED
  ASSIGNED
  NOTE_ADDED
  FOLLOW_UP_SET
  CONVERTED
  EMAIL_DELIVERED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image            String?
  preferredLocale  String    @default("en")
  role             UserRole  @default(CUSTOMER)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  memberships        CustomerMembership[]
  comments           ProjectComment[]
  uploadedFiles      ProjectFile[]
  approvalsResponded ProjectApproval[] @relation("ApprovalResponder")
  changeRequests     ChangeRequest[]
  notifications      Notification[]
  activities         ProjectActivity[] @relation("ActivityActor")
  registeredWebsitePreviewVersions WebsitePreviewVersion[] @relation("WebsitePreviewRegistrar")
  siteChangesRequested ManagedSiteChange[] @relation("ManagedSiteChangeRequester")
  siteChangesApproved  ManagedSiteChange[] @relation("ManagedSiteChangeApprover")
  assignedLeads        SalesLead[]         @relation("LeadAssignee")
  convertedLeads       SalesLead[]         @relation("LeadConverter")
  leadActivities       LeadActivity[]      @relation("LeadActivityActor")
  assignedServiceOrders ServiceOrder[]     @relation("ServiceOrderAssignee")
  requestedServiceOrders ServiceOrder[]    @relation("ServiceOrderRequester")
  serviceOrderActivities ServiceOrderActivity[] @relation("ServiceOrderActivityActor")
  infrastructureActivities InfrastructureActivity[] @relation("InfrastructureActivityActor")
  automationEventsEmitted  AutomationEvent[]        @relation("AutomationEventActor")
  automationDeliveries     AutomationDeliveryJob[]  @relation("AutomationDeliveryRecipient")
  notificationPreferences  CustomerNotificationPreference[]
  ownerReviewDecisions     ProjectOwnerReviewDecision[] @relation("OwnerReviewDecider")
  billingGroupRoles        BillingGroupRole[]
  authorizedBillingMemberships BillingGroupMembership[] @relation("BillingMembershipAuthorizer")
  walletLedgerEntries      WalletLedgerEntry[] @relation("WalletLedgerActor")
  workforceTasksRequested  WorkforceTask[]     @relation("WorkforceTaskRequester")
  workforceApprovalsGiven  WorkforceApproval[] @relation("WorkforceApprover")
  workforcePauseControls   WorkforcePauseControl[] @relation("WorkforcePauseOperator")
  workforceAuditEvents     WorkforceAuditEvent[] @relation("WorkforceAuditActor")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model CustomerAccount {
  id                  String                @id @default(cuid())
  businessName        String
  slug                String                @unique
  status              CustomerAccountStatus @default(ONBOARDING)
  primaryContactName  String?
  primaryContactEmail String?
  locale              String                @default("en")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  memberships     CustomerMembership[]
  projects        Project[]
  supportRequests SupportRequest[]
  services        CustomerService[]
  notifications   Notification[]
  managedSites    ManagedSite[]
  salesLeads      SalesLead[]
  serviceOrders       ServiceOrder[]
  hostingServices     HostingService[]
  managedDomains      ManagedDomain[]
  businessEmailServices BusinessEmailService[]
  automationEvents        AutomationEvent[]
  notificationPreferences CustomerNotificationPreference[]
  websitePreviews              WebsitePreview[]
  billingGroupMemberships      BillingGroupMembership[]
  spendingPolicies             SiteSpendingPolicy[]
  creditReservations           CreditReservation[]
  walletLedgerEntries          WalletLedgerEntry[]
  messageUsage                 MessageUsage[]
  agentToolGrants              AgentToolGrant[]
  agentToolInvocations         AgentToolInvocation[]
  workforceTasks               WorkforceTask[]
}

model CustomerMembership {
  id                String         @id @default(cuid())
  userId            String
  customerAccountId String
  role              MembershipRole @default(MEMBER)
  invitedAt         DateTime?
  lastInviteSentAt  DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, customerAccountId])
  @@index([customerAccountId])
}

model Project {
  id                      String        @id @default(cuid())
  customerAccountId       String
  name                    String
  type                    ProjectType   @default(WEBSITE)
  status                  ProjectStatus @default(ACTIVE)
  progressPercent         Int           @default(0)
  startDate               DateTime?
  targetDate              DateTime?
  estimatedCompletionDate DateTime?
  completedAt             DateTime?
  summary                 String?       @db.Text
  templateId              String?
  templateVersion         String?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  customerAccount CustomerAccount     @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  milestones      ProjectMilestone[]
  tasks           ProjectTask[]
  dependencies    ProjectDependency[]
  activities      ProjectActivity[]
  comments        ProjectComment[]
  files           ProjectFile[]
  approvals       ProjectApproval[]
  changeRequests  ChangeRequest[]
  supportRequests SupportRequest[]
  managedSites    ManagedSite[]
  salesLeads      SalesLead[]
  serviceOrders   ServiceOrder[]
  hostingServices HostingService[]
  ownerReviewDecisions ProjectOwnerReviewDecision[]
  websitePreview  WebsitePreview?

  @@index([customerAccountId])
}

model ProjectMilestone {
  id             String          @id @default(cuid())
  projectId      String
  title          String
  description    String?         @db.Text
  sortOrder      Int             @default(0)
  status         MilestoneStatus @default(PENDING)
  progressWeight Int             @default(10)
  targetDate     DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks        ProjectTask[]
  dependencies ProjectDependency[]

  @@index([projectId])
}

model ProjectTask {
  id           String       @id @default(cuid())
  projectId    String
  milestoneId  String?
  title        String
  description  String?      @db.Text
  status       TaskStatus   @default(TODO)
  assignedSide AssignedSide @default(WEBXXL)
  dueDate      DateTime?
  completedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model ProjectOwnerReviewDecision {
  id              String                @id @default(cuid())
  projectId       String
  itemKey         String
  status          OwnerReviewItemStatus @default(PENDING)
  feedback        String?               @db.Text
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("OwnerReviewDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, itemKey])
  @@index([projectId])
}

model ProjectDependency {
  id                      String           @id @default(cuid())
  projectId               String
  milestoneId             String?
  title                   String
  description             String?          @db.Text
  status                  DependencyStatus @default(REQUESTED)
  customerActionKey       String?
  allowsCustomerAck       Boolean          @default(false)
  requestedFromCustomerAt DateTime         @default(now())
  dueDate                 DateTime?
  resolvedAt              DateTime?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([projectId])
}

model ProjectActivity {
  id          String                   @id @default(cuid())
  projectId   String
  actorUserId String?
  eventType   ProjectActivityEventType
  summary     String
  metadata    Json?
  createdAt   DateTime                 @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation("ActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

model ProjectComment {
  id           String            @id @default(cuid())
  projectId    String
  authorUserId String
  body         String            @db.Text
  visibility   CommentVisibility @default(CUSTOMER)
  changeRequestId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author        User           @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
  @@index([changeRequestId])
}

model ProjectFile {
  id           String              @id @default(cuid())
  projectId    String
  uploadedById String
  originalName String
  storageKey   String
  mimeType     String
  size         Int
  category     ProjectFileCategory @default(OTHER)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User              @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  links      ProjectFileLink[]

  @@index([projectId])
}

/// Associates an existing project file with one workflow record.
/// Exactly one of approval, change request, or support request is set in application code.
model ProjectFileLink {
  id               String   @id @default(cuid())
  projectFileId    String
  approvalId       String?
  changeRequestId  String?
  supportRequestId String?
  createdAt        DateTime @default(now())

  projectFile    ProjectFile      @relation(fields: [projectFileId], references: [id], onDelete: Cascade)
  approval       ProjectApproval? @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  changeRequest  ChangeRequest?   @relation(fields: [changeRequestId], references: [id], onDelete: Cascade)
  supportRequest SupportRequest?  @relation(fields: [supportRequestId], references: [id], onDelete: Cascade)

  @@index([projectFileId])
  @@index([approvalId])
  @@index([changeRequestId])
  @@index([supportRequestId])
}

model ProjectApproval {
  id            String         @id @default(cuid())
  projectId     String
  title         String
  description   String?        @db.Text
  status        ApprovalStatus @default(PENDING)
  requestedAt   DateTime       @default(now())
  respondedAt   DateTime?
  respondedById String?
  responseNotes String?        @db.Text

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  respondedBy User?             @relation("ApprovalResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  fileLinks   ProjectFileLink[]
  /// Present when this approval was opened for one immutable website deployment.
  metadata    Json?
  websitePreviewVersion WebsitePreviewVersion?

  @@index([projectId])
}

model ChangeRequest {
  id            String                @id @default(cuid())
  projectId     String
  submittedById String
  title         String
  description   String                @db.Text
  status        ChangeRequestStatus   @default(SUBMITTED)
  priority      ChangeRequestPriority @default(NORMAL)
  category      ChangeRequestCategory @default(OTHER)
  websitePreviewVersionId String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy User              @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  fileLinks   ProjectFileLink[]
  managedSite ManagedSite?      @relation(fields: [managedSiteId], references: [id], onDelete: SetNull)
  siteChanges ManagedSiteChange[]
  /// Set when this request is the single bound change record for a preview decision.
  websitePreviewVersion WebsitePreviewVersion?
  previewVersionRef WebsitePreviewVersion? @relation("ChangeRequestPreviewVersion", fields: [websitePreviewVersionId], references: [id], onDelete: SetNull)
  comments    ProjectComment[]

  managedSiteId String?

  @@index([projectId])
  @@index([managedSiteId])
  @@index([websitePreviewVersionId])
}

model SupportRequest {
  id                String               @id @default(cuid())
  customerAccountId String
  projectId         String?
  subject           String
  message           String               @db.Text
  status            SupportRequestStatus @default(OPEN)
  priority          SupportPriority      @default(NORMAL)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  customerAccount CustomerAccount   @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  project         Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  fileLinks       ProjectFileLink[]

  @@index([customerAccountId])
}

model CustomerService {
  id                String                @id @default(cuid())
  customerAccountId String
  serviceKey        String
  status            CustomerServiceStatus @default(PENDING)
  externalUrl       String?
  metadata          Json?
  activatedAt       DateTime?
  deactivatedAt     DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@unique([customerAccountId, serviceKey])
}

model Notification {
  id                String           @id @default(cuid())
  userId            String
  customerAccountId String?
  type              NotificationType
  title             String
  body              String           @db.Text
  readAt            DateTime?
  actionUrl         String?
  createdAt         DateTime         @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
}

model ManagedSite {
  id                String                    @id @default(cuid())
  customerAccountId String
  projectId         String?
  name              String
  domain            String                    @unique
  canonicalUrl      String
  status            ManagedSiteStatus         @default(SETUP)
  platform          ManagedSitePlatform       @default(OTHER)
  locale            String                    @default("en")
  connectionType    ManagedSiteConnectionType @default(MANUAL)
  adapterKey        String
  externalAdminUrl  String?
  /// Opaque pointer to a secret stored outside the database. Never a token or password.
  connectionRef     String?
  metadata          Json?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  customerAccount CustomerAccount          @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  project         Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  capabilities    ManagedSiteCapability[]
  changes         ManagedSiteChange[]
  changeRequests  ChangeRequest[]
  walletLedgerEntries WalletLedgerEntry[]
  messageUsage        MessageUsage[]
  agentToolGrants     AgentToolGrant[]
  agentToolInvocations AgentToolInvocation[]

  @@index([customerAccountId])
  @@index([projectId])
}

model ManagedSiteCapability {
  id             String                   @id @default(cuid())
  managedSiteId  String
  capabilityKey  String
  enabled        Boolean                  @default(false)
  executionMode  CapabilityExecutionMode?
  config         Json?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  managedSite ManagedSite @relation(fields: [managedSiteId], references: [id], onDelete: Cascade)

  @@unique([managedSiteId, capabilityKey])
  @@index([managedSiteId])
}

model ManagedSiteChange {
  id                String                   @id @default(cuid())
  managedSiteId     String
  requestedById     String
  capabilityKey     String
  executionMode     CapabilityExecutionMode
  status            ManagedSiteChangeStatus  @default(DRAFT)
  requestText       String?                  @db.Text
  structuredPayload Json?
  previewPayload    Json?
  resultMetadata    Json?
  changeRequestId   String?
  approvedById      String?
  approvedAt        DateTime?
  appliedAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  managedSite   ManagedSite    @relation(fields: [managedSiteId], references: [id], onDelete: Cascade)
  requestedBy   User           @relation("ManagedSiteChangeRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  approvedBy    User?          @relation("ManagedSiteChangeApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  changeRequest ChangeRequest? @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)

  @@index([managedSiteId, createdAt])
  @@index([changeRequestId])
}

model SalesLead {
  id                    String     @id @default(cuid())
  source                LeadSource
  stage                 LeadStage  @default(NEW)
  locale                String     @default("en")
  contactName           String?
  contactEmail          String
  contactPhone          String?
  businessName          String?
  headline              String?
  payload               Json
  referenceCode         String     @unique
  submissionFingerprint String
  resendMessageId       String?
  assignedToId          String?
  followUpAt            DateTime?
  internalNotes         String?    @db.Text
  customerAccountId     String?
  projectId             String?
  convertedAt           DateTime?
  convertedById         String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  assignedTo      User?            @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  convertedBy     User?            @relation("LeadConverter", fields: [convertedById], references: [id], onDelete: SetNull)
  activities      LeadActivity[]

  @@index([stage, createdAt])
  @@index([contactEmail])
  @@index([assignedToId])
  @@index([submissionFingerprint, createdAt])
  @@index([customerAccountId])
}

model LeadActivity {
  id          String           @id @default(cuid())
  leadId      String
  actorUserId String?
  type        LeadActivityType
  summary     String
  metadata    Json?
  createdAt   DateTime         @default(now())

  lead  SalesLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor User?     @relation("LeadActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String
  source    String
  locale    String   @default("en")
  createdAt DateTime @default(now())

  @@unique([email, source])
  @@index([email])
}

model ServiceOrder {
  id                  String             @id @default(cuid())
  publicId            String             @unique
  customerAccountId   String
  projectId           String?
  requestedById       String
  serviceKey          String
  status              ServiceOrderStatus @default(REQUESTED)
  customerNotes       String?            @db.Text
  assignedToId        String?
  internalNotes       String?            @db.Text
  quoteAmountCents    Int?
  quoteCurrency       String?            @default("USD")
  quoteNotes          String?            @db.Text
  billingProvider     String?
  billingProviderRef  String?
  customerServiceId   String?
  billingGroupId      String?
  submissionFingerprint String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  billingGroup    BillingGroup?   @relation(fields: [billingGroupId], references: [id], onDelete: SetNull)
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requestedBy     User            @relation("ServiceOrderRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  assignedTo      User?           @relation("ServiceOrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  activities      ServiceOrderActivity[]

  @@index([customerAccountId, createdAt])
  @@index([status, createdAt])
  @@index([serviceKey])
  @@index([submissionFingerprint, createdAt])
  @@index([billingGroupId])
}

model ServiceOrderActivity {
  id          String                   @id @default(cuid())
  orderId     String
  actorUserId String?
  type        ServiceOrderActivityType
  summary     String
  metadata    Json?
  createdAt   DateTime                 @default(now())

  order ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User?        @relation("ServiceOrderActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

model HostingService {
  id                  String                     @id @default(cuid())
  publicId            String                     @unique
  customerAccountId   String
  projectId           String?
  providerId          String
  externalProviderRef String?
  planLabel           String?
  primaryDomain       String?
  managedDomainId     String?
  status              HostingServiceStatus       @default(PENDING)
  startedAt           DateTime?
  renewsAt            DateTime?
  sslStatus           HostingSslStatus           @default(UNKNOWN)
  managementMode      InfrastructureManagementMode @default(MANUAL)
  dataSource          InfrastructureDataSource     @default(MANUAL)
  notes               String?                    @db.Text
  internalNotes       String?                    @db.Text
  metadata            Json?
  syncRequestedAt     DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  managedDomain   ManagedDomain?  @relation(fields: [managedDomainId], references: [id], onDelete: SetNull)

  @@index([customerAccountId])
  @@index([projectId])
}

model ManagedDomain {
  id                  String                   @id @default(cuid())
  publicId            String                   @unique
  customerAccountId   String
  domainName          String
  registrar           String?
  registeredAt        DateTime?
  expiresAt           DateTime?
  renewalStatus       DomainRenewalStatus      @default(UNKNOWN)
  nameservers         Json?
  dnsProviderId       String?
  verificationStatus  DomainVerificationStatus @default(UNVERIFIED)
  dataSource          InfrastructureDataSource @default(MANUAL)
  providerReference   String?
  internalNotes       String?                  @db.Text
  metadata            Json?
  syncRequestedAt     DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  customerAccount     CustomerAccount      @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  hostingServices     HostingService[]
  businessEmailServices BusinessEmailService[]

  @@unique([customerAccountId, domainName])
  @@index([customerAccountId])
  @@index([expiresAt])
}

model BusinessEmailService {
  id                  String                     @id @default(cuid())
  publicId            String                     @unique
  customerAccountId   String
  managedDomainId     String?
  providerId          String
  planLabel           String?
  mailboxCount        Int                        @default(0)
  renewsAt            DateTime?
  status              BusinessEmailServiceStatus @default(PENDING)
  externalProviderRef String?
  dataSource          InfrastructureDataSource   @default(MANUAL)
  internalNotes       String?                    @db.Text
  metadata            Json?
  syncRequestedAt     DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  managedDomain   ManagedDomain?  @relation(fields: [managedDomainId], references: [id], onDelete: SetNull)

  @@index([customerAccountId])
  @@index([managedDomainId])
}

model InfrastructureActivity {
  id            String                  @id @default(cuid())
  assetType     InfrastructureAssetType
  assetId       String
  customerAccountId String
  actorUserId   String?
  summary       String
  metadata      Json?
  createdAt     DateTime                @default(now())

  actor User? @relation("InfrastructureActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([assetType, assetId, createdAt])
  @@index([customerAccountId, createdAt])
}

model CustomerNotificationPreference {
  id                     String   @id @default(cuid())
  userId                 String
  customerAccountId      String
  projectUpdates         Boolean  @default(true)
  messagesAndApprovals   Boolean  @default(true)
  serviceOrders          Boolean  @default(true)
  infrastructureRenewals Boolean  @default(true)
  transactionalEmail     Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@unique([userId, customerAccountId])
  @@index([customerAccountId])
}

model AutomationEvent {
  id                String              @id @default(cuid())
  dedupeKey         String              @unique
  eventType         AutomationEventType
  customerAccountId String?
  actorUserId       String?
  payload           Json
  createdAt         DateTime            @default(now())

  customerAccount CustomerAccount?        @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  actor           User?                   @relation("AutomationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  deliveries      AutomationDeliveryJob[]

  @@index([customerAccountId, createdAt])
  @@index([eventType, createdAt])
}

model AutomationDeliveryJob {
  id              String                    @id @default(cuid())
  dedupeKey       String                    @unique
  eventId         String
  channel         AutomationDeliveryChannel
  status          AutomationDeliveryStatus  @default(PENDING)
  recipientUserId String?
  recipientEmail  String?
  attempts        Int                       @default(0)
  maxAttempts     Int                       @default(5)
  nextAttemptAt   DateTime                  @default(now())
  lastErrorClass  String?
  providerRef     String?
  deliveredAt     DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  event           AutomationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  recipientUser   User?           @relation("AutomationDeliveryRecipient", fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([eventId])
  @@index([recipientUserId])
}

model InfrastructureRenewalReminder {
  id        String                  @id @default(cuid())
  assetType InfrastructureAssetType
  assetId   String
  windowDays Int
  sentAt    DateTime                @default(now())

  @@unique([assetType, assetId, windowDays])
  @@index([assetType, assetId])
}

/// External website preview for a customer project. The alias URL can change.
/// Customer approval is stored on WebsitePreviewVersion, not on this alias.
model WebsitePreview {
  id                String                 @id @default(cuid())
  projectId         String                 @unique
  customerAccountId String
  provider          WebsitePreviewProvider
  displayName       String
  aliasUrl          String
  status            WebsitePreviewStatus   @default(DEVELOPMENT)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  project         Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customerAccount CustomerAccount          @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  versions        WebsitePreviewVersion[]

  @@index([customerAccountId])
}

/// One immutable provider deployment. Re-registering the same deployment updates this row.
model WebsitePreviewVersion {
  id              String                 @id @default(cuid())
  previewId       String
  provider        WebsitePreviewProvider
  deploymentId    String
  versionLabel    String
  sourceRevision  String?
  registeredUrl   String
  status          WebsitePreviewStatus
  isCurrent       Boolean                @default(true)
  registeredById  String?
  registeredAt    DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  approvalId      String?                @unique
  changeRequestId String?                @unique

  preview       WebsitePreview   @relation(fields: [previewId], references: [id], onDelete: Cascade)
  registeredBy  User?            @relation("WebsitePreviewRegistrar", fields: [registeredById], references: [id], onDelete: SetNull)
  approval      ProjectApproval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  changeRequest ChangeRequest?   @relation(fields: [changeRequestId], references: [id], onDelete: SetNull)
  linkedChangeRequests ChangeRequest[] @relation("ChangeRequestPreviewVersion")

  @@unique([provider, deploymentId])
  @@index([previewId, registeredAt])
}

enum BillingGroupStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum BillingGroupMembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  UNLINKED
}

enum BillingGroupRoleKind {
  GROUP_OWNER
  BILLING_ADMIN
  BILLING_VIEWER
}

enum CreditWalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum WalletLedgerEntryType {
  TOP_UP
  SETTLE
  RELEASE
  REFUND
  ADJUSTMENT
}

enum CreditReservationStatus {
  HELD
  PARTIALLY_SETTLED
  SETTLED
  RELEASED
  EXPIRED
}

enum MessageUsageStatus {
  QUOTED
  RESERVED
  SETTLED
  RELEASED
}

enum ProviderConnectionStatus {
  NOT_CONNECTED
  CONNECTING
  VERIFIED
  DEGRADED
  REVOKED
}

enum AgentToolDecision {
  ALLOWED
  DENIED
}

/// Financial aggregation only. Never grants CRM, contacts, or site operating access.
model BillingGroup {
  id                   String             @id @default(cuid())
  name                 String
  slug                 String             @unique
  status               BillingGroupStatus @default(ACTIVE)
  defaultCurrency      String             @default("USD")
  payerContactId       String?
  billingPolicyVersion String             @default("v1")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  memberships      BillingGroupMembership[]
  roles            BillingGroupRole[]
  profiles         BillingProfile[]
  wallets          CreditWallet[]
  spendingPolicies SiteSpendingPolicy[]
  serviceOrders    ServiceOrder[]
  messageUsage     MessageUsage[]
}

model BillingGroupMembership {
  id                 String                        @id @default(cuid())
  billingGroupId     String
  customerAccountId  String
  status             BillingGroupMembershipStatus  @default(PENDING)
  validFrom          DateTime
  validTo            DateTime?
  authorizedByUserId String?
  walletUseAllowed   Boolean                       @default(true)
  spendingPolicyId   String?
  /// Set to customerAccountId while this is the unique active funding link; null when inactive.
  activeFundingKey   String?                       @unique
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt

  billingGroup    BillingGroup       @relation(fields: [billingGroupId], references: [id], onDelete: Restrict)
  customerAccount CustomerAccount    @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  authorizedBy    User?              @relation("BillingMembershipAuthorizer", fields: [authorizedByUserId], references: [id], onDelete: SetNull)
  spendingPolicy  SiteSpendingPolicy? @relation(fields: [spendingPolicyId], references: [id], onDelete: SetNull)

  @@index([billingGroupId, status])
  @@index([customerAccountId, status])
  @@index([billingGroupId, customerAccountId, validFrom])
}

model BillingGroupRole {
  id              String               @id @default(cuid())
  billingGroupId  String
  userId          String
  role            BillingGroupRoleKind
  capabilityFlags Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  billingGroup BillingGroup @relation(fields: [billingGroupId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([billingGroupId, userId])
  @@index([userId])
}

/// Tokenized payer identity. Never stores card data.
model BillingProfile {
  id                String   @id @default(cuid())
  billingGroupId    String
  legalPayerName    String
  billingAddressRef String?
  taxRef            String?
  currency          String   @default("USD")
  defaultMethodRef  String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  billingGroup BillingGroup @relation(fields: [billingGroupId], references: [id], onDelete: Cascade)

  @@index([billingGroupId])
}

model SiteSpendingPolicy {
  id                 String   @id @default(cuid())
  billingGroupId     String
  customerAccountId  String
  dailyLimit         Int?
  monthlyLimit       Int?
  maxCampaignCredits Int?
  allowedChannels    Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  billingGroup    BillingGroup              @relation(fields: [billingGroupId], references: [id], onDelete: Cascade)
  customerAccount CustomerAccount           @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  memberships     BillingGroupMembership[]

  @@unique([billingGroupId, customerAccountId])
}

/// One wallet per credit type per billing group. Balance is derived from ledger minus holds.
model CreditWallet {
  id             String             @id @default(cuid())
  billingGroupId String
  creditType     String             @default("MESSAGING")
  unit           String             @default("CREDITS")
  status         CreditWalletStatus @default(ACTIVE)
  ledgerSequence Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  billingGroup  BillingGroup         @relation(fields: [billingGroupId], references: [id], onDelete: Restrict)
  ledgerEntries WalletLedgerEntry[]
  reservations  CreditReservation[]
  messageUsage  MessageUsage[]

  @@unique([billingGroupId, creditType])
}

model WalletLedgerEntry {
  id                String                @id @default(cuid())
  walletId          String
  customerAccountId String?
  managedSiteId     String?
  campaignId        String?
  orderId           String?
  type              WalletLedgerEntryType
  deltaCredits      Int
  priceVersion      String
  reservationId     String?
  providerRef       String?
  idempotencyKey    String                @unique
  effectiveAt       DateTime              @default(now())
  createdAt         DateTime              @default(now())
  actorUserId       String?

  wallet          CreditWallet     @relation(fields: [walletId], references: [id], onDelete: Restrict)
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  managedSite     ManagedSite?     @relation(fields: [managedSiteId], references: [id], onDelete: SetNull)
  actor           User?            @relation("WalletLedgerActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@index([customerAccountId, createdAt])
  @@index([reservationId])
}

model CreditReservation {
  id              String                  @id @default(cuid())
  walletId        String
  originAccountId String
  amount          Int
  settledAmount   Int                     @default(0)
  status          CreditReservationStatus @default(HELD)
  expiresAt       DateTime
  correlationId   String
  campaignId      String?
  idempotencyKey  String                  @unique
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  wallet        CreditWallet    @relation(fields: [walletId], references: [id], onDelete: Restrict)
  originAccount CustomerAccount @relation(fields: [originAccountId], references: [id], onDelete: Restrict)
  messageUsage  MessageUsage[]

  @@index([walletId, status])
  @@index([originAccountId])
  @@index([correlationId])
}

model MessageUsage {
  id                String             @id @default(cuid())
  billingGroupId    String
  customerAccountId String
  managedSiteId     String?
  walletId          String
  reservationId     String?
  channel           String
  units             Int
  credits           Int
  status            MessageUsageStatus
  idempotencyKey    String             @unique
  createdAt         DateTime           @default(now())

  billingGroup    BillingGroup       @relation(fields: [billingGroupId], references: [id], onDelete: Restrict)
  customerAccount CustomerAccount    @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  managedSite     ManagedSite?       @relation(fields: [managedSiteId], references: [id], onDelete: SetNull)
  wallet          CreditWallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  reservation     CreditReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([billingGroupId, createdAt])
  @@index([customerAccountId, createdAt])
  @@index([walletId, createdAt])
}

model ProviderConnection {
  id                 String                    @id @default(cuid())
  ownerScope         String
  ownerId            String
  providerKey        String
  externalAccountRef String?
  secretRef          String?
  status             ProviderConnectionStatus  @default(NOT_CONNECTED)
  permissions        Json?
  lastVerifiedAt     DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@unique([ownerScope, ownerId, providerKey])
  @@index([providerKey, status])
}

model AgentToolGrant {
  id                String    @id @default(cuid())
  customerAccountId String
  managedSiteId     String?
  actorId           String
  actorType         String
  toolKey           String
  approvalRequired  Boolean   @default(true)
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  managedSite     ManagedSite?    @relation(fields: [managedSiteId], references: [id], onDelete: SetNull)

  @@index([customerAccountId, toolKey])
  @@index([actorId, toolKey])
}

model AgentToolInvocation {
  id                String            @id @default(cuid())
  grantId           String?
  actorId           String
  actorType         String
  customerAccountId String
  managedSiteId     String?
  toolKey           String
  requestId         String
  correlationId     String?
  approvalId        String?
  inputHash         String
  decision          AgentToolDecision
  denialReason      String?
  createdAt         DateTime          @default(now())

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  managedSite     ManagedSite?    @relation(fields: [managedSiteId], references: [id], onDelete: SetNull)

  @@unique([requestId, toolKey])
  @@index([customerAccountId, createdAt])
}

enum WorkforceTaskStatus {
  DRAFT
  QUEUED
  AWAITING_APPROVAL
  AUTHORIZED
  RUNNING
  COMPLETED
  FAILED
  PAUSED
  CANCELLED
}

enum WorkforceExecutionPhase {
  TASK_PREPARED
  TASK_AUTHORIZED
  PROVIDER_ACCEPTED
  WORK_IN_PROGRESS
  ARTIFACT_PRODUCED
  REVIEW_REQUIRED
  COMPLETED
}

enum WorkforceApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  REVOKED
}

enum WorkforcePauseScope {
  GLOBAL
  AGENT
  TASK
  PROVIDER
}

/// Versioned internal workforce agent catalog (WebXXL-owned IDs).
model InternalAgentDefinition {
  id                 String   @id
  roleKey            String   @unique
  displayName        String
  configVersion      String
  riskTier           Int
  providerAdapterKey String   @default("synthetic")
  liveExecutionEnabled Boolean @default(false)
  paused             Boolean  @default(true)
  allowedToolKeys    Json
  deniedActions      Json
  budgetLimitSubunits Int?
  maxConcurrency     Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  configurations InternalAgentConfiguration[]
  tasks          WorkforceTask[]
}

model InternalAgentConfiguration {
  id           String   @id @default(cuid())
  definitionId String
  version      String
  payload      Json
  effectiveAt  DateTime @default(now())
  createdAt    DateTime @default(now())

  definition InternalAgentDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, version])
}

/// WebXXL-owned internal workforce task (Paperclip IDs stored separately).
model WorkforceTask {
  id                  String                  @id @default(cuid())
  idempotencyKey      String                  @unique
  correlationId       String?
  status              WorkforceTaskStatus     @default(DRAFT)
  executionPhase      WorkforceExecutionPhase?
  internalAgentKey    String
  definitionId        String?
  requestedByUserId   String?
  customerAccountId   String?
  managedSiteId       String?
  projectId           String?
  capability          String
  inputArtifactRef    String?
  inputHash           String
  approvalRequired    Boolean                 @default(true)
  dependsOnTaskId     String?
  providerKey         String                  @default("synthetic")
  externalProviderRunId String?
  externalProviderRef String?
  resultArtifactRef   String?
  errorCode           String?
  errorClass          String?
  attemptCount        Int                     @default(0)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  completedAt         DateTime?

  definition   InternalAgentDefinition? @relation(fields: [definitionId], references: [id], onDelete: SetNull)
  requester    User?                    @relation("WorkforceTaskRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  customerAccount CustomerAccount?      @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  executions   WorkforceExecution[]
  toolCalls    WorkforceToolCall[]
  approvals    WorkforceApproval[]
  budgetUsage  WorkforceBudgetUsage[]
  auditEvents  WorkforceAuditEvent[]

  @@index([status, updatedAt])
  @@index([internalAgentKey, status])
  @@index([customerAccountId, createdAt])
  @@index([correlationId])
}

model WorkforceExecution {
  id                    String                  @id @default(cuid())
  taskId                String
  attemptNumber         Int
  phase                 WorkforceExecutionPhase
  providerKey           String
  externalProviderRunId String?
  status                WorkforceTaskStatus
  startedAt             DateTime                @default(now())
  finishedAt            DateTime?
  resultArtifactRef     String?
  errorCode             String?

  task WorkforceTask @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([taskId, attemptNumber])
  @@index([providerKey, startedAt])
}

model WorkforceToolCall {
  id                String   @id @default(cuid())
  taskId            String
  executionId       String?
  toolKey           String
  requestId         String
  inputHash         String
  approvalId        String?
  decision          AgentToolDecision
  denialReason      String?
  customerAccountId String?
  managedSiteId     String?
  actorId           String
  actorType         String
  createdAt         DateTime @default(now())

  task WorkforceTask @relation(fields: [taskId], references: [id], onDelete: Restrict)

  @@unique([requestId, toolKey])
  @@index([taskId, createdAt])
}

model WorkforceApproval {
  id               String                  @id @default(cuid())
  taskId           String
  status           WorkforceApprovalStatus @default(PENDING)
  approverUserId   String?
  capability       String
  artifactHash     String
  approvedScope    Json?
  expiresAt        DateTime
  maxUses          Int                     @default(1)
  useCount         Int                     @default(0)
  decidedAt        DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  task      WorkforceTask @relation(fields: [taskId], references: [id], onDelete: Restrict)
  approver  User?         @relation("WorkforceApprover", fields: [approverUserId], references: [id], onDelete: SetNull)

  @@index([taskId, status])
  @@index([approverUserId, createdAt])
}

model WorkforceBudgetUsage {
  id              String   @id @default(cuid())
  taskId          String?
  internalAgentKey String
  idempotencyKey  String   @unique
  periodKey       String
  amountSubunits  Int      @default(0)
  costSubunits    Int      @default(0)
  tokenUnits      Int      @default(0)
  reservedSubunits Int     @default(0)
  settledSubunits Int      @default(0)
  released        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  task WorkforceTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([internalAgentKey, periodKey])
}

model WorkforceAuditEvent {
  id          String   @id @default(cuid())
  taskId      String?
  actorUserId String?
  actorType   String
  eventKind   String
  detail      Json?
  createdAt   DateTime @default(now())

  task  WorkforceTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  actor User?          @relation("WorkforceAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([taskId, createdAt])
  @@index([eventKind, createdAt])
}

model WorkforcePauseControl {
  id           String              @id @default(cuid())
  scope        WorkforcePauseScope
  targetKey    String
  active       Boolean             @default(true)
  reason       String?
  setByUserId  String
  createdAt    DateTime            @default(now())
  releasedAt   DateTime?

  operator User @relation("WorkforcePauseOperator", fields: [setByUserId], references: [id], onDelete: Restrict)

  @@index([scope, targetKey, active])
}
