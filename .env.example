# WebXXL public frontend configuration.
# Public values only — never put secrets, service-role keys or payment keys here.

# Canonical site origin used for metadata, sitemap and Open Graph (no trailing slash).
# Defaults to https://www.webxxl.com when unset.
NEXT_PUBLIC_SITE_URL=

# Client portal URL (owned by Cursor). While empty, /login shows the "portal being prepared" state.
NEXT_PUBLIC_CLIENT_PORTAL_URL=

# Confirmed public contact inbox. While empty, no email address is rendered anywhere.
NEXT_PUBLIC_CONTACT_EMAIL=
