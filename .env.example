# Lead form delivery (Resend) — https://resend.com
# Sign up free (3,000 emails/mo), create an API key, and add it here.
# Until this is set, public forms show an honest error instead of a fake confirmation.
RESEND_API_KEY=

# Where lead notification emails go. Defaults to hello@webbxxl.com.
# NOTE: on Resend's free tier without a verified domain, mail can only be
# sent to the Resend account owner's address — sign up with the inbox
# where you want leads to land, or verify webbxxl.com in Resend (one DNS record).
LEADS_TO_EMAIL=hello@webbxxl.com

# Sender identity. onboarding@resend.dev works with no setup; after
# verifying webbxxl.com in Resend you can use e.g. leads@webbxxl.com.
LEADS_FROM_EMAIL=onboarding@resend.dev
