# Lead form delivery (Resend) — https://resend.com
RESEND_API_KEY=

LEADS_TO_EMAIL=hello@webbxxl.com
LEADS_FROM_EMAIL=onboarding@resend.dev

# Auth magic links (reuses Resend when RESEND_API_KEY is set)
AUTH_SECRET=
AUTH_URL=https://www.webbxxl.com
AUTH_FROM_EMAIL=hello@webbxxl.com

# Canonical public site URL — used for canonical tags, sitemap and Open Graph
NEXT_PUBLIC_SITE_URL=https://www.webbxxl.com

# PostgreSQL (Supabase-compatible)
DATABASE_URL=
DIRECT_URL=

# Object storage (server-only). Leave unset to show "file storage is not configured".
# Do not expose STORAGE_SUPABASE_SERVICE_KEY to the browser. Use a private bucket.
# Downloads are short-lived signed URLs issued after account/project authorization.
STORAGE_SUPABASE_URL=
STORAGE_SUPABASE_SERVICE_KEY=
STORAGE_BUCKET=

# Scheduler / Postiz (link-out + health check)
NEXT_PUBLIC_SCHEDULER_URL=https://app.webbxxl.com
POSTIZ_API_TOKEN=

# ABMED shared campaign control API (server-only). Never prefix ABMED_CONTROL_API_SECRET with NEXT_PUBLIC_.
ABMED_CONTROL_API_BASE=https://abmedaesthetics.com
ABMED_CONTROL_API_SECRET=

# Development seed — never set in production
# ALLOW_DEMO_SEED=true
