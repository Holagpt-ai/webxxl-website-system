# Dashboard (client portal) — required env vars
# Set these in your hosting provider (e.g. Vercel project settings).

# Admin login for the client dashboard
DASHBOARD_ADMIN_EMAIL=you@webbxxl.com
# SHA-256 hex of the admin password. Generate with:
#   echo -n "your-password" | sha256sum
DASHBOARD_ADMIN_PASSWORD_SHA256=

# Random string used to sign session cookies. Generate with:
#   openssl rand -hex 32
DASHBOARD_SESSION_SECRET=

# Public URL of the scheduler app (Postiz). Defaults to https://app.webbxxl.com
NEXT_PUBLIC_SCHEDULER_URL=https://app.webbxxl.com

# Phase 2 (after platform approvals): Postiz API token for account stats
# POSTIZ_API_TOKEN=
